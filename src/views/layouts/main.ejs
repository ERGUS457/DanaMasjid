<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'DanaMasjid - Sistem Keuangan Kas Masjid' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdfa',
              100: '#ccfbf1',
              500: '#14b8a6',
              600: '#0d9488',
              700: '#0f766e',
              800: '#115e59',
              900: '#134e4a',
            }
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="stylesheet" href="/css/custom.css">
  <!-- DataTables CSS requested by user -->
  <link href="https://cdn.datatables.net/v/dt/dt-3.0.3/datatables.min.css" rel="stylesheet">
  <%- style %>
</head>
<body class="bg-slate-50 text-slate-800 antialiased h-screen overflow-hidden flex">

  <!-- Desktop Sidebar (Fixed & Stationary) -->
  <aside class="w-64 h-screen flex-shrink-0 hidden md:flex flex-col justify-between bg-slate-900 text-white border-r border-slate-800 shadow-xl z-20 select-none">
    <div class="flex-1 overflow-y-auto min-h-0">
      <!-- Brand Logo -->
      <a href="/" class="p-5 border-b border-slate-800/80 flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-teal-800 p-2 flex items-center justify-center text-white shadow-md shadow-teal-500/20 group-hover:scale-105 transition">
          <img src="/images/logo.svg" alt="Logo Masjid" class="w-full h-full object-contain">
        </div>
        <div>
          <span class="text-xl font-black tracking-tight text-white">Dana<span class="text-teal-400">Masjid</span></span>
          <span class="block text-[10px] text-teal-300 font-medium uppercase tracking-wider">Amanah & Transparan</span>
        </div>
      </a>

      <!-- Mosque Card Active Info -->
      <div class="p-4 mx-3 my-4 bg-slate-800/80 rounded-xl border border-slate-700/60">
        <div class="flex items-center gap-2 text-xs text-teal-400 font-semibold mb-1">
          <i data-lucide="building-2" class="w-3.5 h-3.5"></i> Masjid Terkelola
        </div>
        <div class="font-bold text-sm text-white truncate" title="<%= currentUser ? currentUser.nama_masjid : 'Masjid' %>">
          <%= currentUser ? currentUser.nama_masjid : 'Nama Masjid' %>
        </div>
        <div class="text-[11px] text-slate-400 truncate mt-0.5" title="<%= currentUser ? currentUser.alamat_masjid : '' %>">
          <%= (currentUser && currentUser.alamat_masjid) ? currentUser.alamat_masjid : 'Alamat belum diatur' %>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav class="px-3 space-y-1.5">
        <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= (title.includes('Dashboard')) ? 'bg-teal-700 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
        </a>
        <a href="/transaksi" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= (title.includes('Transaksi')) ? 'bg-teal-700 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
          <i data-lucide="arrow-left-right" class="w-4 h-4"></i> Transaksi Kas
        </a>
        <a href="/kategori" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= (title.includes('Kategori')) ? 'bg-teal-700 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
          <i data-lucide="tags" class="w-4 h-4"></i> Kategori Kas
        </a>
        <a href="/laporan" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition <%= (title.includes('Laporan')) ? 'bg-teal-700 text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800 hover:text-white' %>">
          <i data-lucide="file-text" class="w-4 h-4"></i> Laporan & Rekap
        </a>
      </nav>
    </div>

    <!-- User Profile & Logout (Pinned to Bottom) -->
    <div class="p-4 border-t border-slate-800/80 bg-slate-950/90 flex-shrink-0 mt-auto">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5 overflow-hidden">
          <div class="w-8 h-8 rounded-full bg-slate-700 text-teal-300 flex items-center justify-center font-bold text-xs flex-shrink-0">
            <%= (currentUser && currentUser.nama) ? currentUser.nama.charAt(0).toUpperCase() : 'U' %>
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-semibold text-white truncate"><%= currentUser ? currentUser.nama : 'Pengurus' %></p>
            <p class="text-[10px] text-slate-400 capitalize"><%= currentUser ? currentUser.role : 'Bendahara' %></p>
          </div>
        </div>
        <a href="/auth/logout" title="Keluar Akun" class="p-2 text-slate-400 hover:text-red-400 hover:bg-slate-800 rounded-lg transition">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- Mobile Drawer / Sidebar Overlay -->
  <div id="mobile-sidebar" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden md:hidden">
    <div class="w-64 bg-slate-900 text-white h-full flex flex-col justify-between p-4">
      <div class="flex-1 overflow-y-auto min-h-0">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-teal-800 p-1.5 flex items-center justify-center">
              <img src="/images/logo.svg" alt="Logo Masjid" class="w-full h-full object-contain">
            </div>
            <span class="text-lg font-black text-white">Dana<span class="text-teal-400">Masjid</span></span>
          </a>
          <button onclick="document.getElementById('mobile-sidebar').classList.add('hidden')" class="p-1.5 text-slate-400 hover:text-white rounded-lg">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        <nav class="mt-4 space-y-2">
          <a href="/dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm <%= title.includes('Dashboard') ? 'bg-teal-700 text-white' : 'text-slate-300' %>">
            <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
          </a>
          <a href="/transaksi" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm <%= title.includes('Transaksi') ? 'bg-teal-700 text-white' : 'text-slate-300' %>">
            <i data-lucide="arrow-left-right" class="w-4 h-4"></i> Transaksi Kas
          </a>
          <a href="/kategori" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm <%= title.includes('Kategori') ? 'bg-teal-700 text-white' : 'text-slate-300' %>">
            <i data-lucide="tags" class="w-4 h-4"></i> Kategori Kas
          </a>
          <a href="/laporan" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm <%= title.includes('Laporan') ? 'bg-teal-700 text-white' : 'text-slate-300' %>">
            <i data-lucide="file-text" class="w-4 h-4"></i> Laporan & Rekap
          </a>
        </nav>
      </div>
      <div class="pt-4 border-t border-slate-800 flex-shrink-0 mt-auto">
        <a href="/auth/logout" class="flex items-center gap-2 text-sm text-red-400 hover:text-red-300">
          <i data-lucide="log-out" class="w-4 h-4"></i> Keluar
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content Area (Scrolls independently while sidebar stays stationary) -->
  <div class="flex-1 h-screen overflow-y-auto flex flex-col min-w-0 bg-slate-50">
    
    <!-- Top Header Bar -->
    <header class="h-16 bg-white border-b border-slate-200 px-4 md:px-8 flex items-center justify-between sticky top-0 z-10 shadow-xs flex-shrink-0">
      <div class="flex items-center gap-3">
        <!-- Mobile Toggle Button -->
        <button onclick="document.getElementById('mobile-sidebar').classList.remove('hidden')" class="md:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg" aria-label="Buka Menu">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div>
          <h2 class="text-lg font-bold text-slate-800"><%= title.split('-')[0].trim() %></h2>
        </div>
      </div>

      <!-- Header Right Widgets -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-teal-50 border border-teal-200/70 rounded-full text-xs text-teal-800 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Sistem Pembukuan Aktif
        </div>
      </div>
    </header>

    <!-- Page Body -->
    <main class="flex-1 p-4 md:p-8 max-w-7xl w-full mx-auto">
      <%- include('../partials/alert') %>
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 px-8 text-center text-xs text-slate-500 flex-shrink-0 mt-auto">
      &copy; <%= new Date().getFullYear() %> DanaMasjid - Sistem Tata Kelola & Laporan Kas Masjid Amanah.
    </footer>
  </div>

  <!-- jQuery & DataTables CDN requested by user -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/v/dt/dt-3.0.3/datatables.min.js"></script>
  <script src="/js/main.js"></script>
  <%- script %>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
