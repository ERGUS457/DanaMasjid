<div class="space-y-6">

  <!-- Header & Top Action -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Riwayat Catatan Kas</h1>
      <p class="text-xs text-slate-500 mt-0.5">Kelola seluruh mutasi kas masuk dan kas keluar kas masjid</p>
    </div>
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        onclick="openAddModal()" 
        class="px-4 py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-xs shadow-md transition flex items-center gap-2 cursor-pointer"
      >
        <i data-lucide="plus" class="w-4 h-4"></i> Catat Transaksi Baru
      </button>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-sm">
    <form action="/transaksi" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
      <div>
        <label for="startDate" class="block text-xs font-semibold text-slate-700 mb-1">Dari Tanggal</label>
        <input 
          type="date" 
          id="startDate" 
          name="startDate" 
          value="<%= filters.startDate || '' %>"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
      </div>

      <div>
        <label for="endDate" class="block text-xs font-semibold text-slate-700 mb-1">Sampai Tanggal</label>
        <input 
          type="date" 
          id="endDate" 
          name="endDate" 
          value="<%= filters.endDate || '' %>"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
      </div>

      <div>
        <label for="tipe" class="block text-xs font-semibold text-slate-700 mb-1">Jenis Kas</label>
        <select 
          id="tipe" 
          name="tipe" 
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
          <option value="">-- Semua Jenis Kas --</option>
          <option value="masuk" <%= filters.tipe === 'masuk' ? 'selected' : '' %>>Kas Masuk (Penerimaan)</option>
          <option value="keluar" <%= filters.tipe === 'keluar' ? 'selected' : '' %>>Kas Keluar (Pengeluaran)</option>
        </select>
      </div>

      <div>
        <label for="kategori_id" class="block text-xs font-semibold text-slate-700 mb-1">Pos Kategori</label>
        <select 
          id="kategori_id" 
          name="kategori_id" 
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
          <option value="">-- Semua Kategori --</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= filters.kategori_id === cat.id ? 'selected' : '' %>>
              <%= cat.nama_kategori %> (<%= cat.tipe === 'masuk' ? 'Masuk' : 'Keluar' %>)
            </option>
          <% }); %>
        </select>
      </div>

      <div class="flex gap-2">
        <button 
          type="submit" 
          class="flex-1 py-2 px-3 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-semibold transition flex items-center justify-center gap-1.5"
        >
          <i data-lucide="filter" class="w-3.5 h-3.5"></i> Saring
        </button>
        <a 
          href="/transaksi" 
          class="py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-semibold transition flex items-center justify-center"
          title="Reset Filter"
        >
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
        </a>
      </div>
    </form>
  </div>

  <!-- Mini Summary Bar for Current Filter -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm text-xs">
    <div class="p-2 border-r border-slate-100">
      <span class="text-slate-400 block">Saldo Awal Kas:</span>
      <span class="font-bold text-slate-800 text-sm"><%= formatRupiah(summary.saldo_awal) %></span>
    </div>
    <div class="p-2 border-r border-slate-100">
      <span class="text-emerald-600 block">Total Pemasukan:</span>
      <span class="font-bold text-emerald-700 text-sm">+ <%= formatRupiah(summary.total_masuk) %></span>
    </div>
    <div class="p-2 border-r border-slate-100">
      <span class="text-rose-600 block">Total Pengeluaran:</span>
      <span class="font-bold text-rose-700 text-sm">- <%= formatRupiah(summary.total_keluar) %></span>
    </div>
    <div class="p-2">
      <span class="text-teal-700 block">Saldo Akhir:</span>
      <span class="font-bold text-teal-800 text-sm"><%= formatRupiah(summary.saldo_akhir) %></span>
    </div>
  </div>

  <!-- Transactions Table Card -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[11px] font-semibold border-b border-slate-200">
          <tr>
            <th class="py-3.5 px-4 w-12 text-center">No</th>
            <th class="py-3.5 px-4">Tanggal</th>
            <th class="py-3.5 px-4">Tipe</th>
            <th class="py-3.5 px-4">Kategori Pos</th>
            <th class="py-3.5 px-4">Uraian / Keterangan</th>
            <th class="py-3.5 px-4 text-right">Nominal</th>
            <th class="py-3.5 px-4 text-center w-24">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (transactions.length === 0) { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-slate-400">
                <i data-lucide="receipt" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
                <p class="font-medium text-slate-600">Tidak ada data transaksi yang sesuai filter.</p>
                <p class="text-xs text-slate-400 mt-0.5">Coba atur ulang tanggal atau tambah transaksi baru.</p>
              </td>
            </tr>
          <% } else { %>
            <% transactions.forEach((trx, index) => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 text-center text-xs text-slate-400"><%= index + 1 %></td>
                <td class="py-3.5 px-4 whitespace-nowrap text-xs font-medium text-slate-700">
                  <%= formatTanggalIndo(trx.tanggal) %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <% if (trx.tipe === 'masuk') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                      <i data-lucide="arrow-down-left" class="w-3 h-3"></i> Masuk
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
                      <i data-lucide="arrow-up-right" class="w-3 h-3"></i> Keluar
                    </span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap font-medium text-slate-800 text-xs">
                  <%= trx.nama_kategori || 'Tanpa Kategori' %>
                </td>
                <td class="py-3.5 px-4 text-xs text-slate-600 max-w-sm truncate" title="<%= trx.keterangan || '' %>">
                  <%= trx.keterangan || '-' %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap text-right font-bold text-xs <%= trx.tipe === 'masuk' ? 'text-emerald-700' : 'text-rose-700' %>">
                  <%= trx.tipe === 'masuk' ? '+ ' : '- ' %><%= formatRupiah(trx.nominal) %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap text-center">
                  <div class="flex items-center justify-center gap-1">
                    <button 
                      type="button" 
                      class="btn-edit-trx p-1.5 text-slate-500 hover:text-teal-700 hover:bg-teal-50 rounded-lg transition cursor-pointer"
                      data-id="<%= trx.id %>"
                      data-tipe="<%= trx.tipe %>"
                      data-tanggal="<%= trx.tanggal ? new Date(trx.tanggal).toISOString().split('T')[0] : '' %>"
                      data-kategori="<%= trx.kategori_id || '' %>"
                      data-nominal="<%= trx.nominal %>"
                      data-keterangan="<%- (trx.keterangan || '').replace(/"/g, '&quot;') %>"
                      title="Koreksi / Edit"
                    >
                      <i data-lucide="edit-3" class="w-3.5 h-3.5 pointer-events-none"></i>
                    </button>
                    <button 
                      type="button" 
                      class="btn-delete-trx p-1.5 text-slate-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition cursor-pointer"
                      data-id="<%= trx.id %>"
                      data-label="<%- (trx.keterangan || trx.nama_kategori || 'Transaksi').replace(/"/g, '&quot;') %>"
                      data-nominal="<%= formatRupiah(trx.nominal) %>"
                      title="Hapus Catatan"
                    >
                      <i data-lucide="trash-2" class="w-3.5 h-3.5 pointer-events-none"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal Tambah Transaksi -->
<div id="modal-add" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50">
      <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
        <i data-lucide="plus-circle" class="w-5 h-5 text-teal-700"></i> Catat Transaksi Baru
      </h3>
      <button onclick="closeModal('modal-add')" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/transaksi" method="POST" class="p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Jenis Kas *</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-emerald-50 has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="masuk" id="add-radio-masuk" class="accent-emerald-600" onchange="filterAddCategories('masuk')" checked>
            <span>Kas Masuk (Penerimaan)</span>
          </label>
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-rose-50 has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="keluar" id="add-radio-keluar" class="accent-rose-600" onchange="filterAddCategories('keluar')">
            <span>Kas Keluar (Pengeluaran)</span>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="add_tanggal" class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Transaksi *</label>
          <input 
            type="date" 
            id="add_tanggal" 
            name="tanggal" 
            required 
            value="<%= new Date().toISOString().split('T')[0] %>"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
        </div>
        <div>
          <label for="add_kategori_id" class="block text-xs font-semibold text-slate-700 mb-1">Kategori / Pos Kas (Opsional)</label>
          <select 
            id="add_kategori_id" 
            name="kategori_id" 
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
            <option value="">-- Pilih Pos Kategori (Opsional) --</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" data-type="<%= cat.tipe %>"><%= cat.nama_kategori %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div>
        <label for="add_nominal" class="block text-xs font-semibold text-slate-700 mb-1">Nominal (Rupiah) *</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 font-semibold text-xs">
            Rp
          </div>
          <input 
            type="number" 
            id="add_nominal" 
            name="nominal" 
            required 
            min="100" 
            step="500" 
            placeholder="500000" 
            class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-900 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
        </div>
      </div>

      <div>
        <label for="add_keterangan" class="block text-xs font-semibold text-slate-700 mb-1">Keterangan / Uraian</label>
        <textarea 
          id="add_keterangan" 
          name="keterangan" 
          rows="2"
          placeholder="Rincian catatan transaksi..." 
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none resize-none"
        ></textarea>
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end gap-2.5">
        <button 
          type="button" 
          onclick="closeModal('modal-add')" 
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition"
        >
          Batal
        </button>
        <button 
          type="submit" 
          class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-semibold shadow transition"
        >
          Simpan Catatan
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Transaksi -->
