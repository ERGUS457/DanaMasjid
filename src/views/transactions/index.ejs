            <input type="radio" name="tipe" value="masuk" id="edit-radio-masuk" class="accent-emerald-600" onchange="filterEditCategories('masuk')">
            <span>Kas Masuk (Penerimaan)</span>
          </label>
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-rose-50 has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-800 font-semibold text-xs">
