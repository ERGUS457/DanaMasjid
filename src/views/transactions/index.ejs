<!-- Modal Hapus Transaksi -->
<div id="modal-delete" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-sm overflow-hidden p-6 text-center">
    <div class="w-12 h-12 bg-rose-100 text-rose-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
      <i data-lucide="alert-triangle" class="w-6 h-6"></i>
    </div>
    <h3 class="text-base font-bold text-slate-800">Hapus Catatan Transaksi?</h3>
    <p class="text-xs text-slate-500 mt-1">
      Apakah Anda yakin ingin menghapus catatan <span id="del-label" class="font-semibold text-slate-700"></span> (<span id="del-nominal" class="font-bold text-rose-600"></span>)?
    </p>

    <form id="form-delete" method="POST" class="mt-6 flex justify-center gap-2">
      <button 
        type="button" 
        onclick="closeModal('modal-delete')" 
        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition"
      >
        Batal
      </button>
      <button 
        type="submit" 
        class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-semibold shadow transition"
      >
        Ya, Hapus
      </button>
    </form>
  </div>
</div>

<script>
  window.openAddModal = function() {
    filterAddCategories('masuk');
    openModal('modal-add');
    if (window.lucide) lucide.createIcons();
  };

  window.filterAddCategories = function(type) {
    const select = document.getElementById('add_kategori_id');
    if (!select) return;
    const options = select.querySelectorAll('option[data-type]');
    let firstValid = null;

    options.forEach(opt => {
      if (opt.getAttribute('data-type') === type) {
        opt.hidden = false;
        opt.disabled = false;
        if (!firstValid) firstValid = opt;
      } else {
        opt.hidden = true;
        opt.disabled = true;
        opt.selected = false;
      }
    });

    if (firstValid) {
      firstValid.selected = true;
    } else {
      select.value = '';
    }
  };

  window.openEditModal = function(trx) {
    const form = document.getElementById('form-edit');
    if (!form) return;
    form.action = `/transaksi/${trx.id}/edit`;

    if (trx.tipe === 'masuk') {
      const r = document.getElementById('edit-radio-masuk');
      if (r) r.checked = true;
    } else {
      const r = document.getElementById('edit-radio-keluar');
      if (r) r.checked = true;
    }

    const tgl = trx.tanggal ? new Date(trx.tanggal).toISOString().split('T')[0] : '';
    const dateInput = document.getElementById('edit_tanggal');
    if (dateInput) dateInput.value = tgl;

    const nomInput = document.getElementById('edit_nominal');
    if (nomInput) nomInput.value = trx.nominal;

    const ketInput = document.getElementById('edit_keterangan');
    if (ketInput) ketInput.value = trx.keterangan || '';

    filterEditCategories(trx.tipe, trx.kategori_id);
    openModal('modal-edit');
    if (window.lucide) lucide.createIcons();
  };

  window.filterEditCategories = function(type, currentSelectedId = null) {
    const select = document.getElementById('edit_kategori_id');
    if (!select) return;
    const options = select.querySelectorAll('option[data-type]');
    let matched = false;

    options.forEach(opt => {
      if (opt.getAttribute('data-type') === type) {
        opt.hidden = false;
        opt.disabled = false;
        if (currentSelectedId && opt.value === currentSelectedId) {
          opt.selected = true;
          matched = true;
        }
      } else {
        opt.hidden = true;
        opt.disabled = true;
        opt.selected = false;
      }
    });

    if (!matched) {
      select.value = '';
    }
  };

  window.openDeleteModal = function(id, label, nominal) {
    const form = document.getElementById('form-delete');
    if (!form) return;
    form.action = `/transaksi/${id}/delete`;
    const labelEl = document.getElementById('del-label');
    if (labelEl) labelEl.textContent = label;
    const nomEl = document.getElementById('del-nominal');
    if (nomEl) nomEl.textContent = nominal;
    openModal('modal-delete');
    if (window.lucide) lucide.createIcons();
  };

  // Event Delegation for Edit & Delete Buttons
  document.addEventListener('click', function(e) {
    const editBtn = e.target.closest('.btn-edit-trx');
    if (editBtn) {
      e.preventDefault();
      const trx = {
        id: editBtn.dataset.id,
        tipe: editBtn.dataset.tipe,
        tanggal: editBtn.dataset.tanggal,
        kategori_id: editBtn.dataset.kategori,
        nominal: editBtn.dataset.nominal,
        keterangan: editBtn.dataset.keterangan
      };
      window.openEditModal(trx);
      return;
    }

    const delBtn = e.target.closest('.btn-delete-trx');
    if (delBtn) {
      e.preventDefault();
      window.openDeleteModal(
        delBtn.dataset.id,
        delBtn.dataset.label,
        delBtn.dataset.nominal
      );
      return;
    }
  });
</script>
