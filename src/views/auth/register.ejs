<div class="mb-5">
  <h2 class="text-2xl font-bold text-slate-800 tracking-tight">Registrasi Masjid Baru</h2>
  <p class="text-xs text-slate-500 mt-1">Daftarkan masjid Anda dan kelola kas secara mandiri, rapi & amanah.</p>
</div>

<form action="/auth/register" method="POST" class="space-y-4">
  <!-- Group 1: Profil Pengurus -->
  <div class="space-y-3 pb-3 border-b border-slate-100">
    <span class="text-xs font-bold uppercase tracking-wider text-teal-700 block">1. Profil Pengurus / Bendahara</span>
    
    <div>
      <label for="nama_pengurus" class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap Pengurus *</label>
      <input 
        type="text" 
        id="nama_pengurus" 
        name="nama_pengurus" 
        required 
        placeholder="Contoh: H. Ahmad Fauzi" 
        class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none"
      >
    </div>

    <div>
      <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Email Aktif *</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required 
        placeholder="pengurus@masjid.id" 
        class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none"
      >
    </div>

    <div>
      <label for="password" class="block text-xs font-semibold text-slate-700 mb-1">Kata Sandi (Password) *</label>
      <input 
        type="password" 
        id="password" 
        name="password" 
        required 
        minlength="6"
        placeholder="Minimal 6 karakter" 
        class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none"
      >
    </div>
  </div>

  <!-- Group 2: Data Masjid -->
  <div class="space-y-3">
    <span class="text-xs font-bold uppercase tracking-wider text-teal-700 block">2. Informasi Lembaga Masjid</span>
    
    <div>
      <label for="nama_masjid" class="block text-xs font-semibold text-slate-700 mb-1">Nama Masjid / Musholla *</label>
      <input 
        type="text" 
        id="nama_masjid" 
        name="nama_masjid" 
        required 
        placeholder="Contoh: Masjid Jami' Baiturrahman" 
        class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none"
      >
    </div>

    <div>
      <label for="alamat_masjid" class="block text-xs font-semibold text-slate-700 mb-1">Alamat Masjid</label>
      <textarea 
        id="alamat_masjid" 
        name="alamat_masjid" 
        rows="2"
        placeholder="Jl. Melati No. 12, Kelurahan, Kecamatan, Kota" 
        class="w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none resize-none"
      ></textarea>
    </div>

    <div>
      <label for="saldo_awal" class="block text-xs font-semibold text-slate-700 mb-1">Saldo Awal Kas Saat Ini (Rp)</label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 font-semibold text-xs">
          Rp
        </div>
        <input 
          type="text" 
          inputmode="numeric"
          id="saldo_awal" 
          name="saldo_awal" 
          value="0" 
          placeholder="0" 
          class="currency-input w-full pl-10 pr-3.5 py-2 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-sm focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
      </div>
      <span class="text-[11px] text-slate-400 mt-1 block">Saldo kas riil yang sudah ada sebelum menggunakan sistem ini.</span>
    </div>
  </div>

  <button 
    type="submit" 
    class="w-full py-2.5 px-4 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition duration-200 flex items-center justify-center gap-2 mt-4"
  >
    <i data-lucide="user-plus" class="w-4 h-4"></i> Daftarkan & Mulai Kelola
  </button>
</form>

<div class="mt-5 pt-4 border-t border-slate-100 text-center">
  <p class="text-sm text-slate-600">
    Sudah memiliki akun pengurus? 
    <a href="/auth/login" class="text-teal-700 hover:text-teal-900 font-semibold underline ml-1">
      Masuk di sini
    </a>
  </p>
</div>
