<div class="space-y-6">

  <!-- Header & Top Action -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Kategori Pos Kas Masjid</h1>
      <p class="text-xs text-slate-500 mt-0.5">Atur pos sumber pemasukan dan pos belanja pengeluaran masjid Anda</p>
    </div>
    <div>
      <button 
        type="button" 
        onclick="openModal('modal-add-category')" 
        class="px-4 py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-xs shadow-md transition flex items-center gap-2 cursor-pointer"
      >
        <i data-lucide="plus" class="w-4 h-4"></i> Tambah Kategori Baru
      </button>
    </div>
  </div>

  <!-- Categories Grid (Masuk vs Keluar) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Kolom 1: Pos Kas Masuk -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="p-4 bg-emerald-50 border-b border-emerald-100 flex justify-between items-center">
        <div class="flex items-center gap-2">
          <div class="p-2 bg-emerald-100 text-emerald-700 rounded-xl">
            <i data-lucide="arrow-down-left" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-800 text-sm">Pos Pemasukan (Kas Masuk)</h3>
            <span class="text-[11px] text-emerald-700 font-semibold"><%= categoriesMasuk.length %> Kategori Aktif</span>
          </div>
        </div>
      </div>

      <div class="p-4 divide-y divide-slate-100 flex-1">
        <% if (categoriesMasuk.length === 0) { %>
          <div class="py-8 text-center text-slate-400 text-xs">
            Belum ada kategori pos pemasukan.
          </div>
        <% } else { %>
          <% categoriesMasuk.forEach(cat => { %>
            <div class="py-3 flex items-center justify-between group">
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-sm font-semibold text-slate-800"><%= cat.nama_kategori %></span>
              </div>
              <form action="/kategori/<%= cat.id %>/delete" method="POST" onsubmit="return confirm('Hapus kategori ini? Riwayat transaksi lama akan tetap tersimpan.')">
                <button 
                  type="submit" 
                  class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition"
                  title="Hapus Kategori"
                >
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Kolom 2: Pos Kas Keluar -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <div class="p-4 bg-rose-50 border-b border-rose-100 flex justify-between items-center">
        <div class="flex items-center gap-2">
          <div class="p-2 bg-rose-100 text-rose-700 rounded-xl">
            <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="font-bold text-slate-800 text-sm">Pos Pengeluaran (Kas Keluar)</h3>
            <span class="text-[11px] text-rose-700 font-semibold"><%= categoriesKeluar.length %> Kategori Aktif</span>
          </div>
        </div>
      </div>

      <div class="p-4 divide-y divide-slate-100 flex-1">
        <% if (categoriesKeluar.length === 0) { %>
          <div class="py-8 text-center text-slate-400 text-xs">
            Belum ada kategori pos pengeluaran.
          </div>
        <% } else { %>
          <% categoriesKeluar.forEach(cat => { %>
            <div class="py-3 flex items-center justify-between group">
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                <span class="text-sm font-semibold text-slate-800"><%= cat.nama_kategori %></span>
              </div>
              <form action="/kategori/<%= cat.id %>/delete" method="POST" onsubmit="return confirm('Hapus kategori ini? Riwayat transaksi lama akan tetap tersimpan.')">
                <button 
                  type="submit" 
                  class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition"
                  title="Hapus Kategori"
                >
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Modal Tambah Kategori -->
<div id="modal-add-category" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50">
      <h3 class="font-bold text-slate-800 text-sm sm:text-base flex items-center gap-2">
        <i data-lucide="tag" class="w-4 h-4 text-teal-700"></i> Tambah Pos Kategori Baru
      </h3>
      <button onclick="closeModal('modal-add-category')" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form action="/kategori" method="POST" class="p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tipe Kas *</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-emerald-50 has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="masuk" class="accent-emerald-600" checked>
            <span>Pos Masuk</span>
          </label>
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-rose-50 has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="keluar" class="accent-rose-600">
            <span>Pos Keluar</span>
          </label>
        </div>
      </div>

      <div>
        <label for="nama_kategori" class="block text-xs font-semibold text-slate-700 mb-1">Nama Kategori Pos *</label>
        <input 
          type="text" 
          id="nama_kategori" 
          name="nama_kategori" 
          required 
          placeholder="Contoh: Infak Subuh, Honor Marbot, Konsumsi Majelis" 
          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
        >
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end gap-2.5">
        <button 
          type="button" 
          onclick="closeModal('modal-add-category')" 
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition"
        >
          Batal
        </button>
        <button 
          type="submit" 
          class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-semibold shadow transition"
        >
          Simpan Kategori
        </button>
      </div>
    </form>
  </div>
</div>
