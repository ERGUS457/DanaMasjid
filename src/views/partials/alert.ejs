<% if (typeof messages !== 'undefined') { %>
  <% if (messages.error && messages.error.length > 0) { %>
    <div class="mb-5 flex items-center p-4 text-sm text-red-800 rounded-xl bg-red-50 border border-red-200 shadow-sm" role="alert">
      <svg class="flex-shrink-0 inline w-5 h-5 mr-3 text-red-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <div>
        <span class="font-semibold">Perhatian:</span> <%= messages.error.join(' ') %>
      </div>
    </div>
  <% } %>

  <% if (messages.success && messages.success.length > 0) { %>
    <div class="mb-5 flex items-center p-4 text-sm text-emerald-800 rounded-xl bg-emerald-50 border border-emerald-200 shadow-sm" role="alert">
      <svg class="flex-shrink-0 inline w-5 h-5 mr-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      <div>
        <span class="font-semibold">Berhasil:</span> <%= messages.success.join(' ') %>
      </div>
    </div>
  <% } %>
<% } %>
