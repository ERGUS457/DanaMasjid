<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    @media print {
      body {
        margin: 0;
        padding: 0;
        font-size: 10pt;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800">

  <!-- Floating Print Control Bar (Hidden on Print) -->
  <div class="no-print sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md text-white px-6 py-3 shadow-lg flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="font-bold text-sm">Pratinjau Dokumen Cetak</span>
      <span class="text-xs text-slate-300">| Siap cetak ke format fisik A4 atau Simpan sebagai PDF</span>
    </div>
    <div class="flex items-center gap-2">
      <button 
        onclick="window.print()" 
        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow"
      >
        <i data-lucide="printer" class="w-4 h-4"></i> Cetak Sekarang
      </button>
      <button 
        onclick="window.close(); if(!window.closed){ history.back(); }" 
        class="px-3 py-2 bg-slate-700 hover:bg-slate-800 text-slate-200 rounded-lg text-xs font-semibold transition"
      >
        Tutup
      </button>
    </div>
  </div>

  <!-- A4 Document Paper Container -->
  <div class="max-w-4xl mx-auto my-6 bg-white p-8 md:p-12 shadow-md rounded-xl border border-slate-200 print-container">
    
    <!-- Kop Surat Masjid -->
    <div class="text-center pb-4 border-b-2 border-slate-900 relative">
      <h1 class="text-2xl font-black uppercase tracking-wider text-slate-900"><%= masjid.nama_masjid %></h1>
      <p class="text-xs text-slate-600 mt-1 max-w-xl mx-auto"><%= masjid.alamat || 'Alamat Masjid Belum Diatur' %></p>
      <div class="mt-2 text-[11px] font-bold text-teal-800 uppercase tracking-widest bg-teal-50 py-1 px-4 inline-block rounded-full border border-teal-200">
        Laporan Buku Rekapitulasi Arus Kas
      </div>
    </div>

    <!-- Informasi Periode & Tanggal Cetak -->
    <div class="flex justify-between items-center text-xs py-4 text-slate-600 border-b border-slate-200">
      <div>
        <span class="text-slate-500">Periode Pembukuan:</span>
        <strong class="text-slate-800 ml-1">
          <%= startDate ? formatTanggalIndo(startDate) : 'Awal Pembukuan' %> s/d <%= endDate ? formatTanggalIndo(endDate) : 'Sekarang' %>
        </strong>
      </div>
      <div>
        <span class="text-slate-500">Tanggal Dicetak:</span>
        <strong class="text-slate-800 ml-1"><%= formatTanggalIndo(new Date()) %></strong>
      </div>
    </div>

    <!-- Kotak Ringkasan Kas -->
    <div class="grid grid-cols-4 gap-3 my-5">
      <div class="p-3 border border-slate-200 rounded-lg bg-slate-50 text-center">
        <span class="text-[10px] uppercase font-bold text-slate-500 block">Saldo Awal</span>
        <span class="text-xs font-bold text-slate-800"><%= formatRupiah(summary.saldo_awal) %></span>
      </div>
      <div class="p-3 border border-emerald-200 rounded-lg bg-emerald-50/50 text-center">
        <span class="text-[10px] uppercase font-bold text-emerald-700 block">Total Penerimaan</span>
        <span class="text-xs font-bold text-emerald-800">+ <%= formatRupiah(summary.total_masuk) %></span>
      </div>
      <div class="p-3 border border-rose-200 rounded-lg bg-rose-50/50 text-center">
        <span class="text-[10px] uppercase font-bold text-rose-700 block">Total Pengeluaran</span>
        <span class="text-xs font-bold text-rose-800">- <%= formatRupiah(summary.total_keluar) %></span>
      </div>
      <div class="p-3 border border-teal-300 rounded-lg bg-teal-50 text-center">
        <span class="text-[10px] uppercase font-bold text-teal-800 block">Saldo Kas Akhir</span>
        <span class="text-xs font-extrabold text-teal-900"><%= formatRupiah(summary.saldo_akhir) %></span>
      </div>
    </div>

    <!-- Tabel Rincian Mutasi Transaksi -->
    <table class="w-full text-left text-xs border border-slate-300 border-collapse mb-8">
      <thead>
        <tr class="bg-slate-100 text-slate-700 border-b border-slate-300 font-bold">
          <th class="p-2 border-r border-slate-300 w-8 text-center">No</th>
          <th class="p-2 border-r border-slate-300 w-24">Tanggal</th>
          <th class="p-2 border-r border-slate-300 w-32">Pos Kategori</th>
          <th class="p-2 border-r border-slate-300">Uraian / Keterangan</th>
          <th class="p-2 border-r border-slate-300 text-right w-28">Penerimaan (Rp)</th>
          <th class="p-2 text-right w-28">Pengeluaran (Rp)</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions.length === 0) { %>
          <tr>
            <td colspan="6" class="p-6 text-center text-slate-400">
              Tidak ada catatan mutasi transaksi kas pada periode yang dipilih.
            </td>
          </tr>
        <% } else { %>
          <% transactions.forEach((trx, idx) => { %>
            <tr class="border-b border-slate-200 <%= idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60' %>">
              <td class="p-2 border-r border-slate-300 text-center text-slate-500"><%= idx + 1 %></td>
              <td class="p-2 border-r border-slate-300 whitespace-nowrap"><%= formatTanggalIndo(trx.tanggal) %></td>
              <td class="p-2 border-r border-slate-300 font-medium"><%= trx.nama_kategori || 'Tanpa Kategori' %></td>
              <td class="p-2 border-r border-slate-300"><%= trx.keterangan || '-' %></td>
              <td class="p-2 border-r border-slate-300 text-right font-medium text-emerald-800">
                <%= trx.tipe === 'masuk' ? formatRupiah(trx.nominal) : '-' %>
              </td>
              <td class="p-2 text-right font-medium text-rose-800">
                <%= trx.tipe === 'keluar' ? formatRupiah(trx.nominal) : '-' %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
      <tfoot>
        <tr class="bg-slate-100 font-bold border-t-2 border-slate-400 text-slate-800">
          <td colspan="4" class="p-2 text-right border-r border-slate-300 uppercase text-[11px]">Jumlah Total:</td>
          <td class="p-2 text-right border-r border-slate-300 text-emerald-800 font-bold"><%= formatRupiah(summary.total_masuk) %></td>
          <td class="p-2 text-right text-rose-800 font-bold"><%= formatRupiah(summary.total_keluar) %></td>
        </tr>
      </tfoot>
    </table>

    <!-- Kolom Tanda Tangan Pertanggungjawaban -->
    <div class="grid grid-cols-2 gap-8 text-center text-xs mt-10 pt-4">
      <div>
        <p class="text-slate-600">Mengetahui,</p>
        <p class="font-bold text-slate-800 mt-1">Ketua DKM <%= masjid.nama_masjid %></p>
        <div class="h-20"></div>
        <p class="font-bold text-slate-800 underline">( .................................................... )</p>
      </div>

      <div>
        <p class="text-slate-600">Disusun dan dilaporkan oleh,</p>
        <p class="font-bold text-slate-800 mt-1">Bendahara Kas Masjid</p>
        <div class="h-20"></div>
        <p class="font-bold text-slate-800 underline">( .................................................... )</p>
      </div>
    </div>

    <!-- Catatan Cetak -->
    <div class="mt-12 text-[10px] text-slate-400 text-center border-t border-slate-100 pt-3">
      Dokumen ini dicetak secara otomatis dari Sistem Pencatatan Keuangan DanaMasjid.
    </div>

  </div>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
