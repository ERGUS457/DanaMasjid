<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DanaMasjid - Aplikasi Pembukuan & Transparansi Kas Masjid Amanah</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdfa',
              100: '#ccfbf1',
              200: '#99f6e4',
              300: '#5eead4',
              400: '#2dd4bf',
              500: '#14b8a6',
              600: '#0d9488',
              700: '#0f766e',
              800: '#115e59',
              900: '#134e4a',
              950: '#042f2e',
            }
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-teal-500 selection:text-white">

  <!-- 1. TOP ANNOUNCEMENT BANNER -->
  <div class="bg-gradient-to-r from-teal-900 via-emerald-800 to-teal-900 text-white text-xs py-2 px-4 text-center font-medium border-b border-teal-700/50 flex items-center justify-center gap-2">
    <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-teal-950 uppercase tracking-wider">
      Amanah & Transparan
    </span>
    <span>Aplikasi Tata Kelola & Laporan Kas Masjid Terpercaya untuk Kemakmuran Jamaah</span>
  </div>

  <!-- 2. NAVBAR -->
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-teal-700 p-1.5 shadow-sm shadow-teal-700/20 group-hover:scale-105 transition duration-200 flex-shrink-0 flex items-center justify-center">
          <img src="/images/logo.svg" alt="Logo Masjid" class="w-full h-full object-contain">
        </div>
        <div>
          <span class="text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 flex items-center">
            Dana<span class="text-teal-600">Masjid</span>
          </span>
          <span class="block text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-wider -mt-0.5">Kas Terbuka & Amanah</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600">
        <a href="#modul" class="hover:text-teal-700 transition flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span> Modul Panduan
        </a>
        <a href="#fitur" class="hover:text-teal-700 transition">Keunggulan</a>
        <a href="#demo" class="hover:text-teal-700 transition">Uji Coba</a>
        <a href="#faq" class="hover:text-teal-700 transition">Tanya Jawab</a>
        <a href="#komentar" class="hover:text-teal-700 transition flex items-center gap-1">
          <i data-lucide="message-square" class="w-3.5 h-3.5 text-teal-600"></i> Komentar Jamaah
        </a>
      </nav>

      <!-- Auth Action Buttons -->
      <div class="flex items-center gap-3">
        <% if (currentUser) { %>
          <a 
            href="/dashboard" 
            class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-xs shadow-md transition flex items-center gap-2"
          >
            <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard (<%= currentUser.nama_masjid %>)
          </a>
        <% } else { %>
          <a 
            href="/auth/login" 
            class="px-3.5 py-2 text-slate-700 hover:text-teal-800 hover:bg-slate-100 rounded-xl text-xs font-semibold transition flex items-center gap-1.5"
          >
            <i data-lucide="log-in" class="w-3.5 h-3.5"></i> Masuk
          </a>
          <a 
            href="/auth/register" 
            class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-xs shadow-md shadow-teal-700/20 hover:shadow-lg transition flex items-center gap-1.5"
          >
            <i data-lucide="user-plus" class="w-3.5 h-3.5"></i> Daftarkan Masjid
          </a>
        <% } %>
      </div>

    </div>
  </header>

  <!-- 3. HERO SECTION -->
  <section class="relative pt-12 pb-20 overflow-hidden bg-gradient-to-b from-teal-50/50 via-white to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-100 text-teal-800 text-xs font-bold mb-5 shadow-xs border border-teal-200">
          <img src="/images/logo.svg" alt="Mosque" class="w-4 h-4"> Solusi Pencatatan Keuangan Digital DKM & Bendahara
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight sm:leading-none">
          Tata Kelola Kas Masjid <br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-700 via-emerald-600 to-teal-800">
            Amanah, Rapi & Transparan
          </span>
        </h1>

        <p class="mt-5 text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Tinggalkan pembukuan manual di buku tulis yang rawan hilang. Catat infak Jumat, sedekah, operasional listrik, hingga honor ustadz secara terstruktur, siap cetak ke format resmi A4, dan ekspor ke PDF/Excel kapan saja.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a 
            href="/auth/register" 
            class="w-full sm:w-auto px-6 py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-bold rounded-xl shadow-lg shadow-teal-700/25 transition duration-200 flex items-center justify-center gap-2 text-sm"
          >
            <i data-lucide="church" class="w-4 h-4"></i> Daftarkan Masjid Sekarang (Gratis)
          </a>
          <a 
            href="#demo" 
            class="w-full sm:w-auto px-6 py-3.5 bg-white hover:bg-slate-100 text-slate-800 font-semibold rounded-xl border border-slate-300 shadow-sm transition duration-200 flex items-center justify-center gap-2 text-sm"
          >
            <i data-lucide="play-circle" class="w-4 h-4 text-teal-600"></i> Coba Akun Uji Coba (Demo)
          </a>
        </div>

        <div class="mt-5 flex items-center justify-center gap-6 text-xs text-slate-500 font-medium">
          <span class="flex items-center gap-1.5"><i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i> 1 Akun Khusus Tiap Masjid</span>
          <span class="flex items-center gap-1.5"><i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i> Pembukuan Terpisah & Terjaga</span>
          <span class="flex items-center gap-1.5"><i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i> Penyimpanan Online Aman</span>
        </div>
      </div>

      <!-- Hero Mockup Display Card -->
      <div class="max-w-5xl mx-auto bg-slate-900 rounded-3xl p-3 sm:p-5 shadow-2xl border border-slate-800 shadow-teal-950/40">
        <div class="bg-slate-950 rounded-2xl p-5 sm:p-8 text-white border border-slate-800/80">
          
          <!-- Mockup Header -->
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-6 border-b border-slate-800">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-teal-800 p-2 shadow-inner">
                <img src="/images/logo.svg" alt="Logo" class="w-full h-full object-contain">
              </div>
              <div>
                <h3 class="text-base font-bold text-white">Masjid Raya Al-Ikhlas</h3>
                <p class="text-xs text-slate-400">Jl. Merdeka No. 45, Kota Sejahtera &bull; Akun Terverifikasi</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 text-xs font-semibold rounded-full flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Kas Aktif Terkelola
              </span>
            </div>
          </div>

          <!-- Mockup Stats Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
              <span class="text-[11px] text-slate-400 uppercase font-semibold">Saldo Kas Saat Ini</span>
              <div class="text-2xl font-black text-teal-400 mt-1">Rp 45.250.000</div>
              <span class="text-[10px] text-slate-500 mt-1 block">Saldo riil di rekening/brankas</span>
            </div>
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
              <span class="text-[11px] text-emerald-400 uppercase font-semibold">Kas Masuk Bulan Ini</span>
              <div class="text-2xl font-black text-emerald-400 mt-1">+ Rp 14.800.000</div>
              <span class="text-[10px] text-slate-500 mt-1 block">Infak Jumat, Tromol, Sedekah</span>
            </div>
            <div class="bg-slate-900 p-4 rounded-xl border border-slate-800">
              <span class="text-[11px] text-rose-400 uppercase font-semibold">Kas Keluar Bulan Ini</span>
              <div class="text-2xl font-black text-rose-400 mt-1">- Rp 6.250.000</div>
              <span class="text-[10px] text-slate-500 mt-1 block">Listrik PLN, Honor Khotib, Kebersihan</span>
            </div>
          </div>

          <!-- Mockup Action Banner -->
          <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 text-slate-300">
              <i data-lucide="printer" class="w-4 h-4 text-teal-400"></i>
              <span>Laporan Rekapitulasi Pembukuan Kas Siap Cetak dan Diunduh</span>
            </div>
            <div class="flex gap-2">
              <span class="px-2.5 py-1 bg-teal-900/60 text-teal-300 rounded-lg text-[11px] font-semibold border border-teal-700/50">Cetak A4 Siap Tempel</span>
              <span class="px-2.5 py-1 bg-rose-950/60 text-rose-300 rounded-lg text-[11px] font-semibold border border-rose-700/50">Unduh PDF</span>
              <span class="px-2.5 py-1 bg-emerald-950/60 text-emerald-300 rounded-lg text-[11px] font-semibold border border-emerald-700/50">Unduh CSV / Excel</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- 4. MODUL PENGGUNAAN & PANDUAN SISTEM (USER GUIDE) -->
  <section id="modul" class="py-20 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-teal-50 py-1.5 px-3.5 rounded-full border border-teal-200">
          Buku Panduan & Alur Kerja
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-3">
          5 Modul Utama Penggunaan Sistem
        </h2>
        <p class="mt-3 text-sm text-slate-600">
          DanaMasjid dirancang sangat intuitif agar dapat langsung digunakan oleh bendahara atau pengurus DKM tanpa memerlukan keahlian akuntansi yang rumit.
        </p>
      </div>

      <!-- Modules Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Modul 1 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-teal-400 transition hover:shadow-lg flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-black text-lg mb-5 shadow-md shadow-teal-700/20 group-hover:scale-105 transition">
              01
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Modul 1: Registrasi Masjid & Akun Pengurus</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Langkah mudah mendaftarkan masjid dan pengurus baru:
            </p>
            <ul class="space-y-2 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Isi nama pengurus, email, kata sandi, nama masjid & alamat.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Masukkan <strong>Saldo Awal Kas</strong> riil yang ada sebelum menggunakan aplikasi.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Sistem secara otomatis menyiapkan buku kas mandiri dan 8 kategori pos kas standar.</span>
              </li>
            </ul>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200/80 text-[11px] font-semibold text-teal-700">
            Akses: Halaman Registrasi (/auth/register)
          </div>
        </div>

        <!-- Modul 2 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-teal-400 transition hover:shadow-lg flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-black text-lg mb-5 shadow-md shadow-teal-700/20 group-hover:scale-105 transition">
              02
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Modul 2: Personalisasi Kategori Pos Kas</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Atur pos-pos pemasukan dan pengeluaran kas sesuai kebutuhan khas masjid:
            </p>
            <ul class="space-y-2 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span><strong>Pos Masuk:</strong> Infak Kotak Jumat, Zakat, Donatur Renovasi, dll.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span><strong>Pos Keluar:</strong> Listrik PLN, Air PDAM, Honor Khotib, Marbot.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Bebas menambah pos baru atau menghapus pos yang tidak terpakai.</span>
              </li>
            </ul>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200/80 text-[11px] font-semibold text-teal-700">
            Akses: Menu Kategori Kas (/kategori)
          </div>
        </div>

        <!-- Modul 3 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-teal-400 transition hover:shadow-lg flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-black text-lg mb-5 shadow-md shadow-teal-700/20 group-hover:scale-105 transition">
              03
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Modul 3: Pencatatan Mutasi Kas Harian</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Pencatatan uang masuk dan keluar dengan alur cepat dan tanpa salah input:
            </p>
            <ul class="space-y-2 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Pilih jenis transaksi (Kas Masuk atau Kas Keluar).</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Pilih kategori pos kas, tanggal pembukuan, nominal, dan keterangan.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Disediakan tombol <strong>Edit/Koreksi</strong> dan <strong>Hapus</strong> catatan.</span>
              </li>
            </ul>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200/80 text-[11px] font-semibold text-teal-700">
            Akses: Menu Transaksi Kas (/transaksi)
          </div>
        </div>

        <!-- Modul 4 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-teal-400 transition hover:shadow-lg flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-black text-lg mb-5 shadow-md shadow-teal-700/20 group-hover:scale-105 transition">
              04
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Modul 4: Monitoring Kas Real-Time</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Dashboard pintar yang secara otomatis menghitung dan mengagregasi saldo:
            </p>
            <ul class="space-y-2 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Perhitungan otomatis: <code>Saldo Berjalan = Saldo Awal + Total Masuk - Total Keluar</code>.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Indikator kinerja penerimaan & pengeluaran kas bulan ini.</span>
              </li>
              <li class="flex items-start gap-2">
                <i data-lucide="check" class="w-4 h-4 text-teal-600 flex-shrink-0 mt-0.5"></i>
                <span>Filter mutasi riwayat berdasarkan rentang tanggal & pos anggaran.</span>
              </li>
            </ul>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200/80 text-[11px] font-semibold text-teal-700">
            Akses: Menu Dashboard (/dashboard)
          </div>
        </div>

        <!-- Modul 5 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 hover:border-teal-400 transition hover:shadow-lg flex flex-col justify-between group md:col-span-2 lg:col-span-2">
          <div>
            <div class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center font-black text-lg mb-5 shadow-md shadow-teal-700/20 group-hover:scale-105 transition">
              05
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Modul 5: Laporan Rekapitulasi & Ekspor Dokumen</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Sarana pelaporan resmi untuk pengumuman kepada jamaah dan pertanggungjawaban DKM:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
              <div class="bg-white p-3.5 rounded-xl border border-slate-200">
                <div class="flex items-center gap-2 font-bold text-slate-900 text-xs mb-1">
                  <i data-lucide="printer" class="w-4 h-4 text-slate-700"></i> Cetak A4 Siap Tempel
                </div>
                <p class="text-[11px] text-slate-500">Tata letak cetak resmi dengan kop surat nama masjid dan kolom tanda tangan Ketua DKM & Bendahara.</p>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-slate-200">
                <div class="flex items-center gap-2 font-bold text-rose-700 text-xs mb-1">
                  <i data-lucide="file-down" class="w-4 h-4 text-rose-600"></i> Ekspor PDF Langsung
                </div>
                <p class="text-[11px] text-slate-500">Unduh dokumen PDF laporan resmi yang dapat langsung dibagikan via grup WhatsApp pengurus / jamaah.</p>
              </div>

              <div class="bg-white p-3.5 rounded-xl border border-slate-200">
                <div class="flex items-center gap-2 font-bold text-emerald-700 text-xs mb-1">
                  <i data-lucide="sheet" class="w-4 h-4 text-emerald-600"></i> Ekspor Excel (CSV)
                </div>
                <p class="text-[11px] text-slate-500">Dilengkapi format UTF-8 BOM sehingga langsung terbuka rapi di Microsoft Excel atau Google Sheets.</p>
              </div>
            </div>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-200/80 text-[11px] font-semibold text-teal-700">
            Akses: Menu Laporan & Rekap (/laporan)
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. KEUNGGULAN UTAMA & KEAMANAN KAS MASJID -->
  <section id="fitur" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-teal-100 py-1.5 px-3.5 rounded-full">
          Keunggulan Utama
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-3">
          Mengapa Menggunakan DanaMasjid?
        </h2>
        <p class="mt-3 text-sm text-slate-600">
          Dirancang untuk membantu pengurus DKM mengemban amanah umat secara rapi, terbuka, dan bertanggung jawab.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Fitur 1 -->
        <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center mb-5">
            <i data-lucide="shield-check" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Privasi & Buku Kas Mandiri</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Catatan keuangan kas masjid Anda terlindungi dan terpisah seutuhnya. Pengurus masjid lain tidak dapat melihat rincian kas masjid Anda demi menjaga privasi dan amanah jamaah.
          </p>
        </div>

        <!-- Fitur 2 -->
        <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center mb-5">
            <i data-lucide="cloud" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Penyimpanan Online Aman</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Seluruh catatan kas tersimpan rapi secara digital di peladen aman. Bebas dari risiko buku kas robek, basah, tercecer, atau hilang saat terjadi pergantian kepengurusan DKM.
          </p>
        </div>

        <!-- Fitur 3 -->
        <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center mb-5">
            <i data-lucide="smartphone" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-2">Mudah Diakses dari HP</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Bisa dibuka dengan nyaman langsung dari HP smartphone bendahara saat menghitung kotak infak setelah sholat Jumat, tablet, maupun laptop kantor sekretariat masjid.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 6. DEMO AKUN SIAP COBA -->
  <section id="demo" class="py-16 bg-gradient-to-br from-teal-900 via-slate-900 to-teal-950 text-white relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <div class="w-16 h-16 rounded-2xl bg-teal-700 p-3 mx-auto mb-4 shadow-xl shadow-teal-500/20">
        <img src="/images/logo.svg" alt="Logo" class="w-full h-full object-contain">
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Ingin Mencoba Langsung Tanpa Mendaftar?</h2>
      <p class="mt-2 text-xs sm:text-sm text-teal-200/90 max-w-xl mx-auto">
        Gunakan akun pengujian demo kami untuk menjelajahi dashboard, mencatat transaksi, dan mencetak laporan kas.
      </p>

      <div class="mt-8 bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 max-w-md mx-auto text-left shadow-2xl">
        <span class="text-[10px] font-bold uppercase tracking-wider text-teal-300 block mb-3">Kredensial Akun Demo</span>
        <div class="space-y-2.5 text-xs text-slate-200">
          <div class="flex justify-between items-center py-1.5 border-b border-white/10">
            <span class="text-slate-400">Masjid Contoh:</span>
            <span class="font-bold text-white">Masjid Raya Al-Ikhlas</span>
          </div>
          <div class="flex justify-between items-center py-1.5 border-b border-white/10">
            <span class="text-slate-400">Email:</span>
            <span class="font-mono font-bold text-teal-300">bendahara@masjid.id</span>
          </div>
          <div class="flex justify-between items-center py-1.5">
            <span class="text-slate-400">Kata Sandi:</span>
            <span class="font-mono font-bold text-teal-300">password123</span>
          </div>
        </div>

        <a 
          href="/auth/login" 
          class="mt-5 w-full py-2.5 bg-emerald-500 hover:bg-emerald-600 text-teal-950 font-bold rounded-xl text-xs transition duration-200 flex items-center justify-center gap-2 shadow-lg"
        >
          <i data-lucide="log-in" class="w-4 h-4"></i> Masuk dengan Akun Demo Sekarang
        </a>
      </div>

    </div>
  </section>

  <!-- 7. FAQ (PERTANYAAN UMUM) -->
  <section id="faq" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-700 bg-teal-50 py-1.5 px-3.5 rounded-full border border-teal-200">
          Pertanyaan Populer
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-3">
          Tanya Jawab Seputar DanaMasjid
        </h2>
      </div>

      <div class="space-y-4">
        
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
          <h4 class="font-bold text-sm text-slate-900 mb-1 flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-teal-600"></i> Apakah pengurus masjid lain bisa melihat data kas masjid kami?
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed pl-6">
            Sama sekali tidak. Setiap masjid memiliki pembukuan kas tersendiri yang terpisah rapat. Sistem secara otomatis membatasi akses sehingga pengurus hanya dapat mengelola kas masjid yang didaftarkan.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
          <h4 class="font-bold text-sm text-slate-900 mb-1 flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-teal-600"></i> Bagaimana jika masjid kami sudah memiliki saldo sebelum menggunakan aplikasi ini?
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed pl-6">
            Saat pertama kali mendaftar, Anda dapat memasukkan nilai <strong>Saldo Awal Kas</strong> riil saat itu. Saldo berjalan berikutnya akan otomatis diakumulasikan dari saldo awal tersebut ditambah pemasukan baru dan dikurangi pengeluaran baru.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
          <h4 class="font-bold text-sm text-slate-900 mb-1 flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-teal-600"></i> Bagaimana cara mencetak laporan untuk ditempel di papan pengumuman masjid?
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed pl-6">
            Buka menu <strong>Laporan & Rekap</strong>, tentukan rentang tanggal yang ingin dilaporkan (misal periode 1 minggu atau 1 bulan), lalu klik tombol <strong>Cetak / Print</strong>. Halaman cetak didesain rapi sesuai ukuran kertas A4 dengan kop surat masjid dan kolom tanda tangan Ketua DKM.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
          <h4 class="font-bold text-sm text-slate-900 mb-1 flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-teal-600"></i> Apakah laporan bisa dibuka di Microsoft Excel?
          </h4>
          <p class="text-xs text-slate-600 leading-relaxed pl-6">
            Ya! Fitur <strong>Ekspor Excel (CSV)</strong> telah dilengkapi dengan format UTF-8 BOM, sehingga saat Anda membuka berkas hasil download di Microsoft Excel atau Google Sheets, seluruh kolom, angka, dan teks bahasa Indonesia akan langsung tersusun rapi tanpa berantakan.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- 8. FITUR KOMENTAR & DOA JAMAAH (AUTO-SLIDING) -->
  <section id="komentar" class="py-20 bg-gradient-to-b from-slate-50 via-teal-50/20 to-slate-100 overflow-hidden border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-800 bg-teal-100/80 py-1.5 px-3.5 rounded-full border border-teal-200/60">
          Suara Umat & Doa Jamaah
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight mt-3">
          Kesan, Pesan & Aspirasi Jamaah
        </h2>
        <p class="mt-3 text-xs sm:text-sm text-slate-600">
          Tuliskan doa kebaikan atau masukan untuk kemakmuran masjid kita bersama. Komentar Anda akan otomatis tampil dan bergeser di bawah ini.
        </p>
      </div>

      <!-- Form Tambah Komentar -->
      <div class="max-w-2xl mx-auto bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-slate-200/90 mb-12">
        <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 mb-1">
          <i data-lucide="message-square-plus" class="w-5 h-5 text-teal-700"></i> Tuliskan Pesan atau Doa Anda
        </h3>
        <p class="text-xs text-slate-500 mb-5">
          Nama bersifat opsional. Jika dikosongkan, nama Anda otomatis tercatat sebagai <strong>Anonim (Hamba Allah)</strong>.
        </p>

        <form id="comment-form" action="/komentar" method="POST" class="space-y-4">
          <div>
            <label for="comment-nama" class="block text-xs font-semibold text-slate-700 mb-1">
              Nama Anda <span class="text-slate-400 font-normal">(Kosongkan jika ingin anonim)</span>
            </label>
            <input 
              type="text" 
              id="comment-nama" 
              name="nama" 
              placeholder="Contoh: H. Abdullah, atau kosongkan untuk 'Hamba Allah'" 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-900 focus:ring-2 focus:ring-teal-600 focus:outline-none transition"
            >
          </div>

          <div>
            <label for="comment-pesan" class="block text-xs font-semibold text-slate-700 mb-1">
              Komentar / Doa Kebaikan *
            </label>
            <textarea 
              id="comment-pesan" 
              name="komentar" 
              required 
              rows="3"
              placeholder="Tuliskan doa untuk pengurus DKM, kesan transparansi kas masjid, atau pesan kebaikan..." 
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-900 focus:ring-2 focus:ring-teal-600 focus:outline-none resize-none transition"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <span class="text-[11px] text-slate-500 flex items-center gap-1.5">
              <i data-lucide="shield" class="w-3.5 h-3.5 text-teal-600"></i> Terbuka untuk seluruh umat & jamaah
            </span>
            <button 
              type="submit" 
              id="btn-submit-comment"
              class="px-5 py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-xs shadow-md shadow-teal-700/20 hover:shadow-lg transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <i data-lucide="send" class="w-3.5 h-3.5"></i> Kirimkan Komentar
            </button>
          </div>
        </form>

        <div id="comment-alert" class="mt-4 hidden p-3.5 rounded-xl text-xs font-semibold animate-in fade-in duration-200"></div>
      </div>

    </div>

    <!-- Auto-sliding Track (Marquee Bergeser Otomatis) -->
    <div class="relative w-full overflow-hidden py-3">
      <!-- Gradient Fades on edges -->
      <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-r from-slate-50 to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-gradient-to-l from-slate-50 to-transparent z-10 pointer-events-none"></div>

      <div class="comments-track flex gap-4 px-4 items-stretch" id="comments-container">
        <% const listToRender = (typeof comments !== 'undefined' && comments && comments.length > 0) ? comments : []; %>
        <% if (listToRender.length > 0) { %>
          <% for (let loop = 0; loop < 2; loop++) { %>
            <% listToRender.forEach(c => { %>
              <div class="comment-card w-80 sm:w-96 flex-shrink-0 bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm flex flex-col justify-between hover:border-teal-400 hover:shadow-md transition">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <div class="flex items-center gap-2.5">
                      <div class="w-9 h-9 rounded-xl <%= c.nama.toLowerCase().includes('hamba allah') ? 'bg-amber-100 text-amber-800' : 'bg-teal-100 text-teal-800' %> flex items-center justify-center font-bold text-xs flex-shrink-0">
                        <% if (c.nama.toLowerCase().includes('hamba allah')) { %>
                          <i data-lucide="moon" class="w-4 h-4 text-amber-700"></i>
                        <% } else { %>
                          <%= c.nama.charAt(0).toUpperCase() %>
                        <% } %>
                      </div>
                      <div>
                        <h4 class="font-bold text-slate-800 text-xs truncate max-w-[170px]"><%= c.nama %></h4>
                        <span class="text-[10px] text-slate-400"><%= new Date(c.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                      </div>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold <%= c.nama.toLowerCase().includes('hamba allah') ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-teal-50 text-teal-700 border border-teal-200' %>">
                      <%= c.nama.toLowerCase().includes('hamba allah') ? 'Anonim' : 'Jamaah' %>
                    </span>
                  </div>

                  <p class="text-xs text-slate-600 leading-relaxed italic">
                    "<%= c.komentar %>"
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
                  <span class="flex items-center gap-1 text-teal-700 font-semibold">
                    <i data-lucide="heart" class="w-3 h-3 text-rose-500 fill-rose-500"></i> Doa Jamaah
                  </span>
                  <span>DanaMasjid</span>
                </div>
              </div>
            <% }); %>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Ticker Hint -->
    <div class="text-center mt-3 text-[11px] text-slate-400">
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-xs">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-500"></i> Komentar bergeser otomatis &bull; Arahkan kursor untuk menjeda
      </span>
    </div>

  </section>

  <!-- 9. CTA PENUTUP -->
  <section class="py-16 bg-gradient-to-r from-teal-800 to-emerald-900 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Siap Memulai Digitalisasi Keuangan Masjid Anda?</h2>
      <p class="mt-2 text-sm text-teal-100 max-w-xl mx-auto">
        Tingkatkan kepercayaan para jamaah dan donatur dengan keterbukaan laporan keuangan yang tertib dan akurat.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a 
          href="/auth/register" 
          class="px-6 py-3 bg-white text-teal-900 font-bold rounded-xl shadow-lg hover:bg-teal-50 transition text-sm flex items-center gap-2"
        >
          <i data-lucide="user-plus" class="w-4 h-4"></i> Daftarkan Masjid Gratis
        </a>
      </div>
    </div>
  </section>

  <!-- 10. FOOTER -->
  <footer class="bg-slate-950 text-slate-400 text-xs py-10 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-teal-800 p-1">
          <img src="/images/logo.svg" alt="Logo" class="w-full h-full object-contain">
        </div>
        <span class="font-bold text-white text-sm">Dana<span class="text-teal-400">Masjid</span></span>
        <span>&mdash; Aplikasi Pembukuan Kas Masjid Terpercaya</span>
      </div>
      <div class="text-center sm:text-right">
        &copy; <%= new Date().getFullYear() %> DanaMasjid. Didedikasikan untuk kemakmuran dan transparansi masjid di seluruh Indonesia.
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    lucide.createIcons();

    // Script Penanganan Pengiriman Komentar Tanpa Reload
    const commentForm = document.getElementById('comment-form');
    if (commentForm) {
      commentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btn-submit-comment');
        const alertBox = document.getElementById('comment-alert');
        const namaInput = document.getElementById('comment-nama');
        const pesanInput = document.getElementById('comment-pesan');

        const nama = namaInput.value.trim();
        const komentar = pesanInput.value.trim();

        if (!komentar) return;

        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i> Mengirimkan...';
        if (window.lucide) lucide.createIcons();

        try {
          const res = await fetch('/komentar', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ nama, komentar })
          });

          const data = await res.json();
          if (data.success) {
            alertBox.className = 'mt-4 p-3.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 block';
            alertBox.innerHTML = 'Alhamdulillah! Komentar Anda berhasil dikirim dan telah bergabung dalam deretan komentar yang bergeser.';
            namaInput.value = '';
            pesanInput.value = '';

            // Masukkan kartu komentar baru langsung ke container slider
            const container = document.getElementById('comments-container');
            if (container && data.comment) {
              const isAnon = data.comment.nama.toLowerCase().includes('hamba allah');
              const cardHTML = `
                <div class="comment-card w-80 sm:w-96 flex-shrink-0 bg-white rounded-2xl p-5 border-2 border-emerald-400 shadow-md flex flex-col justify-between animate-in fade-in duration-300">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl ${isAnon ? 'bg-amber-100 text-amber-800' : 'bg-teal-100 text-teal-800'} flex items-center justify-center font-bold text-xs flex-shrink-0">
                          ${isAnon ? '<i data-lucide="moon" class="w-4 h-4 text-amber-700"></i>' : data.comment.nama.charAt(0).toUpperCase()}
                        </div>
                        <div>
                          <h4 class="font-bold text-slate-800 text-xs truncate max-w-[170px]">${data.comment.nama}</h4>
                          <span class="text-[10px] text-emerald-600 font-semibold">Baru Saja</span>
                        </div>
                      </div>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold ${isAnon ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-teal-50 text-teal-700 border border-teal-200'}">
                        ${isAnon ? 'Anonim' : 'Jamaah'}
                      </span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed italic">
                      "${data.comment.komentar}"
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
                    <span class="flex items-center gap-1 text-teal-700 font-semibold">
                      <i data-lucide="heart" class="w-3 h-3 text-rose-500 fill-rose-500"></i> Doa Jamaah
                    </span>
                    <span>DanaMasjid</span>
                  </div>
                </div>
              `;
              container.insertAdjacentHTML('afterbegin', cardHTML);
              if (window.lucide) lucide.createIcons();
            }

            setTimeout(() => {
              alertBox.classList.add('hidden');
            }, 7000);
          } else {
            alertBox.className = 'mt-4 p-3.5 rounded-xl text-xs font-semibold bg-red-50 text-red-800 border border-red-200 block';
            alertBox.innerHTML = data.message || 'Gagal mengirim komentar.';
          }
        } catch (err) {
          console.error(err);
          commentForm.submit();
        } finally {
          btn.disabled = false;
          btn.innerHTML = '<i data-lucide="send" class="w-3.5 h-3.5"></i> Kirimkan Komentar';
          if (window.lucide) lucide.createIcons();
        }
      });
    }
  </script>
</body>
</html>
