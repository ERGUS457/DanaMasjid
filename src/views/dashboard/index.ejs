<div class="space-y-6">

  <!-- Welcome Banner -->
  <div class="bg-gradient-to-r from-teal-800 to-emerald-900 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <span class="inline-block px-3 py-1 bg-teal-700/60 rounded-full text-xs font-semibold uppercase tracking-wider text-teal-200 mb-2">
        Ringkasan Kas Bulan <%= stats.bulan_nama %>
      </span>
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight">Assalamu'alaikum, <%= currentUser ? currentUser.nama : 'Pengurus' %></h1>
      <p class="text-teal-100/90 text-sm mt-1">Laporan arus kas terkini untuk <span class="font-semibold text-white"><%= currentUser ? currentUser.nama_masjid : 'Masjid' %></span>.</p>
    </div>
    <div class="flex gap-2.5">
      <button 
        type="button" 
        onclick="openTransactionModal('masuk')" 
        class="px-4 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-xl text-sm shadow-md transition flex items-center gap-2 cursor-pointer"
      >
        <i data-lucide="plus-circle" class="w-4 h-4"></i> Kas Masuk
      </button>
      <button 
        type="button" 
        onclick="openTransactionModal('keluar')" 
        class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-xl text-sm shadow-md transition flex items-center gap-2 cursor-pointer"
      >
        <i data-lucide="minus-circle" class="w-4 h-4"></i> Kas Keluar
      </button>
    </div>
  </div>

  <!-- Stat Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
    
    <!-- 1. Saldo Kas Berjalan -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm relative overflow-hidden">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Saldo Kas Saat Ini</p>
          <h3 class="text-2xl font-extrabold text-slate-900 mt-1"><%= formatRupiah(stats.saldo_berjalan) %></h3>
        </div>
        <div class="p-3 bg-teal-50 text-teal-700 rounded-xl">
          <i data-lucide="wallet" class="w-6 h-6"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
        <span>Saldo Awal:</span>
        <span class="font-semibold text-slate-700"><%= formatRupiah(stats.saldo_awal) %></span>
      </div>
    </div>

    <!-- 2. Kas Masuk Bulan Ini -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Pemasukan Bulan Ini</p>
          <h3 class="text-2xl font-extrabold text-emerald-700 mt-1"><%= formatRupiah(stats.masuk_bulan_ini) %></h3>
        </div>
        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
          <i data-lucide="arrow-down-left" class="w-6 h-6"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500 flex items-center gap-1">
        <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-400"></i>
        <span><%= stats.bulan_nama %></span>
      </div>
    </div>

    <!-- 3. Kas Keluar Bulan Ini -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-xs font-semibold text-rose-600 uppercase tracking-wider">Pengeluaran Bulan Ini</p>
          <h3 class="text-2xl font-extrabold text-rose-700 mt-1"><%= formatRupiah(stats.keluar_bulan_ini) %></h3>
        </div>
        <div class="p-3 bg-rose-50 text-rose-600 rounded-xl">
          <i data-lucide="arrow-up-right" class="w-6 h-6"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500 flex items-center gap-1">
        <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-400"></i>
        <span><%= stats.bulan_nama %></span>
      </div>
    </div>

    <!-- 4. Total Transaksi -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Catatan Transaksi</p>
          <h3 class="text-2xl font-extrabold text-slate-900 mt-1"><%= stats.total_transaksi %> <span class="text-sm font-normal text-slate-500">kali</span></h3>
        </div>
        <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl">
          <i data-lucide="receipt" class="w-6 h-6"></i>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500">
        <a href="/transaksi" class="text-teal-700 font-semibold hover:underline flex items-center gap-1">
          Buka riwayat lengkap <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- Recent Transactions Section -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <div>
        <h3 class="text-base font-bold text-slate-800">Riwayat Transaksi Terakhir</h3>
        <p class="text-xs text-slate-500">7 transaksi kas terbaru yang tercatat di sistem</p>
      </div>
      <a href="/transaksi" class="text-xs font-semibold text-teal-700 hover:text-teal-800 bg-teal-50 px-3 py-1.5 rounded-lg transition flex items-center gap-1">
        Lihat Semua <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[11px] font-semibold border-b border-slate-200">
          <tr>
            <th class="py-3.5 px-4">Tanggal</th>
            <th class="py-3.5 px-4">Tipe</th>
            <th class="py-3.5 px-4">Kategori</th>
            <th class="py-3.5 px-4">Keterangan</th>
            <th class="py-3.5 px-4 text-right">Nominal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (recentTransactions.length === 0) { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-400">
                <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                Belum ada data transaksi kas yang dicatat.
              </td>
            </tr>
          <% } else { %>
            <% recentTransactions.forEach(trx => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3.5 px-4 whitespace-nowrap text-xs font-medium text-slate-700">
                  <%= formatTanggalIndo(trx.tanggal) %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <% if (trx.tipe === 'masuk') { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                      <i data-lucide="arrow-down-left" class="w-3 h-3"></i> Masuk
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-800">
                      <i data-lucide="arrow-up-right" class="w-3 h-3"></i> Keluar
                    </span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap font-medium text-slate-800 text-xs">
                  <%= trx.nama_kategori || 'Tanpa Kategori' %>
                </td>
                <td class="py-3.5 px-4 text-xs text-slate-600 max-w-xs truncate">
                  <%= trx.keterangan || '-' %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap text-right font-bold text-xs <%= trx.tipe === 'masuk' ? 'text-emerald-700' : 'text-rose-700' %>">
                  <%= trx.tipe === 'masuk' ? '+ ' : '- ' %><%= formatRupiah(trx.nominal) %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal Tambah Transaksi Cepat -->
<div id="modal-transaction" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50">
      <h3 id="modal-title" class="font-bold text-slate-800 text-base flex items-center gap-2">
        <i data-lucide="plus-circle" class="w-5 h-5 text-teal-700"></i> Catat Transaksi Baru
      </h3>
      <button onclick="closeModal('modal-transaction')" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/transaksi" method="POST" class="p-6 space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Jenis Kas *</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-emerald-50 has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="masuk" id="radio-masuk" class="accent-emerald-600" onchange="filterModalCategories('masuk')" checked>
            <span>Kas Masuk (Penerimaan)</span>
          </label>
          <label class="flex items-center justify-center gap-2 p-2.5 border border-slate-300 rounded-xl cursor-pointer hover:bg-rose-50 has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-800 font-semibold text-xs">
            <input type="radio" name="tipe" value="keluar" id="radio-keluar" class="accent-rose-600" onchange="filterModalCategories('keluar')">
            <span>Kas Keluar (Pengeluaran)</span>
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="tanggal" class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Transaksi *</label>
          <input 
            type="date" 
            id="tanggal" 
            name="tanggal" 
            required 
            value="<%= new Date().toISOString().split('T')[0] %>"
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
        </div>
        <div>
          <label for="kategori_id" class="block text-xs font-semibold text-slate-700 mb-1">Kategori / Pos Kas *</label>
          <select 
            id="kategori_id" 
            name="kategori_id" 
            required
            class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
            <option value="">-- Pilih Pos Kategori --</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" data-type="<%= cat.tipe %>"><%= cat.nama_kategori %> (<%= cat.tipe === 'masuk' ? 'Masuk' : 'Keluar' %>)</option>
            <% }); %>
          </select>
        </div>
      </div>

      <div>
        <label for="nominal" class="block text-xs font-semibold text-slate-700 mb-1">Nominal (Rupiah) *</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 font-semibold text-xs">
            Rp
          </div>
          <input 
            type="number" 
            id="nominal" 
            name="nominal" 
            required 
            min="100" 
            step="500" 
            placeholder="Contoh: 500000" 
            class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-900 focus:ring-2 focus:ring-teal-600 focus:outline-none"
          >
        </div>
      </div>

      <div>
        <label for="keterangan" class="block text-xs font-semibold text-slate-700 mb-1">Keterangan / Uraian Transaksi</label>
        <textarea 
          id="keterangan" 
          name="keterangan" 
          rows="2"
          placeholder="Catatan sumber infak atau peruntukan belanja operasional..." 
          class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs text-slate-800 focus:ring-2 focus:ring-teal-600 focus:outline-none resize-none"
        ></textarea>
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end gap-2.5">
        <button 
          type="button" 
          onclick="closeModal('modal-transaction')" 
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition"
        >
          Batal
        </button>
        <button 
          type="submit" 
          class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-semibold shadow transition"
        >
          Simpan Catatan
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openTransactionModal(type = 'masuk') {
    if (type === 'masuk') {
      document.getElementById('radio-masuk').checked = true;
      document.getElementById('modal-title').innerHTML = '<i data-lucide="plus-circle" class="w-5 h-5 text-emerald-600"></i> Catat Kas Masuk (Penerimaan)';
    } else {
      document.getElementById('radio-keluar').checked = true;
      document.getElementById('modal-title').innerHTML = '<i data-lucide="minus-circle" class="w-5 h-5 text-rose-600"></i> Catat Kas Keluar (Pengeluaran)';
    }
    filterModalCategories(type);
    openModal('modal-transaction');
    lucide.createIcons();
  }

  function filterModalCategories(type) {
    const select = document.getElementById('kategori_id');
    const options = select.querySelectorAll('option[data-type]');
    let hasSelected = false;

    options.forEach(opt => {
      if (opt.getAttribute('data-type') === type) {
        opt.style.display = 'block';
        if (!hasSelected) {
          opt.selected = true;
          hasSelected = true;
        }
      } else {
        opt.style.display = 'none';
        opt.selected = false;
      }
    });

    if (!hasSelected && select.options.length > 0) {
      select.selectedIndex = 0;
    }
  }
</script>
